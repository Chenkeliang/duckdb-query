#!/bin/sh

# . "$(dirname "$0")/_/husky.sh" # Removed dependency


# DuckQuery Git Pre-commit Hook
# 在提交前自动检查代码规范

echo "🔍 运行代码规范检查..."

# 获取暂存的文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# 检查前端文件
FRONTEND_FILES=$(echo "$STAGED_FILES" | grep "^frontend/src/" || true)
if [ -n "$FRONTEND_FILES" ]; then
    echo "📦 检查前端文件..."
    cd frontend
    npm run lint -- --quiet
    FRONTEND_EXIT=$?
    cd ..
    
    if [ $FRONTEND_EXIT -ne 0 ]; then
        echo "❌ 前端代码检查失败，请修复后再提交"
        exit 1
    fi
fi

# 检查后端文件（排除 scripts 目录，因为是一次性脚本）
BACKEND_FILES=$(echo "$STAGED_FILES" | grep "^api/" | grep "\.py$" | grep -v "^api/scripts/" || true)
if [ -n "$BACKEND_FILES" ]; then
    echo "🐍 检查后端文件..."
    
    # 尝试检测 Python 环境
    if [ -f ".venv/bin/python" ]; then
        PYTHON_CMD="$(pwd)/.venv/bin/python"
    elif [ -f "api/.venv/bin/python" ]; then
        PYTHON_CMD="$(pwd)/api/.venv/bin/python"
    else
        PYTHON_CMD="python"
    fi
    
    # 设置 PYTHONPATH 以确保能够解析 core 等模块
    export PYTHONPATH=$PYTHONPATH:$(pwd)/api
    
    # 运行 Pylint - 全项目检查，与 CI 行为一致
    # 避免"本地通过但 CI 失败"的问题
    cd api
    $PYTHON_CMD -m pylint --rcfile=.pylintrc routers/ core/ models/ utils/ services/
    BACKEND_EXIT=$?
    cd ..
    
    if [ $BACKEND_EXIT -ne 0 ]; then
        echo "❌ 后端代码检查失败，请修复后再提交"
        exit 1
    fi
fi

echo "✅ 代码检查通过"
exit 0
