// ============================================================================
// DuckQuery 应用配置示例 / Application config example
//
// 用法 / Usage:
//   复制本文件为 config/app-config.json（去掉注释）或 config/app-config.jsonc（保留注释）。
//   Copy this to config/app-config.json (strip comments) or app-config.jsonc (keep comments).
//   优先级 / Precedence: app-config.json > app-config.jsonc。
//
// 约定 / Conventions:
//   - null            = 使用系统默认 / use built-in default.
//   - 单位已在每项注明 / units are noted per field (bytes / seconds / ms / hours).
//   - [ENV]           = 该项可被同名环境变量覆盖 / can be overridden by the listed env var.
//   - 改动后需重启后端生效 / restart the backend to apply changes.
//   - 启动时后端会按当前字段集自动补全/裁剪本文件（删除的旧字段会被自动清除）。
//     On startup the backend reconciles this file to the current field set (stale keys are dropped).
// ============================================================================
{
  // ==================== 基础应用 / Basic ====================

  // 调试模式：输出详细日志 / Verbose logging. 默认 false。 [ENV: DEBUG]
  "debug": false,

  // 允许的前端跨域来源 / Allowed CORS origins. [ENV: CORS_ORIGINS（逗号分隔）]
  "cors_origins": [
    "http://localhost:3000",
    "http://localhost:5173"
  ],

  // 导出文件目录 / Export directory. null = <项目根>/exports。 [ENV: EXPORTS_DIR]
  "exports_dir": null,

  // 应用时区 / Timezone. 默认 "Asia/Shanghai"。 [ENV: TIMEZONE]
  "timezone": "Asia/Shanghai",

  // ==================== 性能与限制 / Limits ====================

  // 最大上传文件大小（字节）/ Max upload size (bytes). 默认 50GB。 [ENV: MAX_FILE_SIZE]
  "max_file_size": 53687091200,

  // 页面查询最大返回行数 / Max rows returned to the UI. 默认 10000；
  // 超过请用导出 / use export for more. [ENV: MAX_QUERY_ROWS]
  // （需与 frontend/src/constants/queryLimits.ts 的 DEFAULT_MAX_QUERY_ROWS 保持一致）
  "max_query_rows": 10000,

  // 侧栏表预览最大数量 / Max tables listed in sidebar. 默认 200。
  "max_tables": 200,

  // 表元数据缓存有效期（小时）/ Table-metadata cache TTL (hours). <=0 关闭缓存。默认 24。
  "table_metadata_cache_ttl_hours": 24,

  // ==================== DuckDB 引擎 / Engine ====================

  // 内存上限 / Memory limit（支持 KB/MB/GB）。默认 "8GB"。
  "duckdb_memory_limit": "8GB",

  // 并行线程数 / Parallel threads. 省略则跟随 CPU 核心数（默认，推荐）。
  // "duckdb_threads": 8,

  // 目录配置 / Directory paths. 全部 null = 用默认结构 data/duckdb/...
  "duckdb_data_dir": null,            // 数据根目录 / data root [ENV: DUCKDB_DATA_DIR]
  "duckdb_database_path": null,       // 主库文件 / main DB file (默认 <data_dir>/main.db) [ENV: DUCKDB_DATABASE_PATH]
  "duckdb_temp_directory": null,      // 溢写/临时目录 / spill & temp dir
  "duckdb_extension_directory": null, // 扩展安装目录 / extension dir [ENV: DUCKDB_EXTENSION_DIRECTORY]
  "duckdb_home_directory": null,      // home 目录 / home dir [ENV: DUCKDB_HOME_DIRECTORY]

  // 查询性能分析格式 / Profiling format: "no_output" | "json" | "query_tree_optimizer"。
  // 默认 no_output（不向 stderr 刷执行树）。注意 "query_tree" 会被重映射为 no_output
  // 防刷屏；要执行树诊断用 query_tree_optimizer 或 json。
  "duckdb_enable_profiling": "no_output",
  // 性能分析输出文件 / Profiling output file. null = 不写文件。
  "duckdb_profiling_output": null,

  // 优化开关 / Optimizer flags
  "duckdb_prefer_range_joins": false,        // 优先范围 JOIN / prefer range joins. 默认 false。
  "duckdb_enable_object_cache": true,        // 对象缓存 / object cache. DuckDB 1.5.3 起为 no-op，仅兼容保留。
  "duckdb_preserve_insertion_order": false,  // 保持插入顺序（false 更快）/ preserve insertion order. 默认 false。
  "duckdb_enable_progress_bar": false,       // 查询进度条（生产关）/ progress bar. 默认 false。

  // 慢查询自动 EXPLAIN 阈值（毫秒）/ Auto-EXPLAIN threshold (ms). 0 = 关闭；生产可设 5000。
  // [ENV: DUCKDB_AUTO_EXPLAIN_THRESHOLD_MS]
  "duckdb_auto_explain_threshold_ms": 0,

  // JSON/JSONL 入湖默认列类型 / JSON import column typing:
  //   "auto"    = 由 DuckDB 推断 / inferred by DuckDB
  //   "variant" = 各列存为 VARIANT / store columns as VARIANT
  "json_import_column_type": "auto",

  // 启动预加载的扩展 / Auto-loaded extensions.
  //   httpfs = 通过 http(s)/S3 读取远程文件（远程 URL / S3 入湖必需）/ required for http(s)/S3 remote reads.
  //   mysql / postgres = 联邦查询连接外部库 / federated connections.
  "duckdb_extensions": [
    "excel",
    "json",
    "parquet",
    "httpfs",
    "mysql",
    "postgres"
  ],

  // 远程存储 SET 语句 / Remote storage settings（启动时执行；S3/OSS 时配合 httpfs）。
  // 值需带引号，如 "'cn-hangzhou'"。 [ENV: DUCKDB_REMOTE_SETTINGS（JSON 字符串）]
  "duckdb_remote_settings": {
    // "s3_region": "'cn-hangzhou'",
    // "s3_endpoint": "'oss-cn-hangzhou.aliyuncs.com'",
    // "s3_url_style": "'path'",
    // "s3_use_ssl": "true",
    // "s3_access_key_id": "'...'",
    // "s3_secret_access_key": "'...'"
  },

  // ==================== 数据挂载 / Data mounts ====================

  // 服务器本地目录挂载 / Local directory mounts：允许前端浏览并导入这些路径下的文件。
  // Docker 下 path 必须是容器内路径（见 docker-compose 的 volumes 映射）。
  // Under Docker, path must be the in-container path mapped by docker-compose.
  "server_data_mounts": [
    {
      "label": "Shared Data",
      "path": "/app/server_mounts"
    },
    {
      "label": "macOS Downloads",
      "path": "/app/host_downloads"
    },
    {
      "label": "macOS Documents",
      "path": "/app/host_documents"
    }
  ],

  // ==================== 连接池 / Connection pool ====================

  "pool_min_connections": 2,        // 最小连接数 / min. [ENV: POOL_MIN_CONNECTIONS]
  "pool_max_connections": 10,       // 最大连接数 / max. [ENV: POOL_MAX_CONNECTIONS]
  "pool_connection_timeout": 30,    // 取连接超时（秒）/ acquire timeout (s). [ENV: POOL_CONNECTION_TIMEOUT]
  "pool_idle_timeout": 300,         // 空闲回收（秒）/ idle timeout (s). [ENV: POOL_IDLE_TIMEOUT]
  "pool_max_retries": 3,            // 取连接重试次数 / retries. [ENV: POOL_MAX_RETRIES]
  "pool_wait_timeout": 1.0,         // 等待空闲连接超时（秒）/ wait-for-slot (s). [ENV: POOL_WAIT_TIMEOUT]

  // ==================== 外部库超时 / External DB timeouts (seconds) ====================

  "db_connect_timeout": 10,         // 连接超时 / connect. [ENV: DB_CONNECT_TIMEOUT]
  "db_read_timeout": 30,            // 读超时 / read. [ENV: DB_READ_TIMEOUT]
  "db_write_timeout": 30,           // 写超时 / write. [ENV: DB_WRITE_TIMEOUT]

  // ==================== 其他超时 / Other timeouts (seconds) ====================

  "url_reader_timeout": 30,         // 远程 URL 读取超时 / remote URL read. [ENV: URL_READER_TIMEOUT]
  "url_reader_head_timeout": 10,    // 远程 URL HEAD 探测超时 / URL HEAD probe. [ENV: URL_READER_HEAD_TIMEOUT]
  "sqlite_timeout": 10,             // SQLite 连接超时 / SQLite connect. [ENV: SQLITE_TIMEOUT]
  "federated_query_timeout": 300    // 联邦查询前端超时（秒）/ federated query (s). 默认 300。 [ENV: FEDERATED_QUERY_TIMEOUT]
}
